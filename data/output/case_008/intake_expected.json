    "code": {
      "text": "MRI Lumbar Spine without contrast"
    },
    "effectiveDateTime": "2026-09-22T08:15:00",
    "issued": "2026-09-22T15:02:00",
    "basedOn": [
      {
        "display": "Ruth Sandoval, MD, Georgetown Family Physicians"
