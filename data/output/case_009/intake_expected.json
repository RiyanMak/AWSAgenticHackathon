    "code": {
      "text": "CT Abdomen and Pelvis with IV contrast"
    },
    "effectiveDateTime": "2026-10-18T16:40:00",
    "issued": "2026-10-18T17:12:00",
    "basedOn": [
      {
        "display": "Alicia Moreno, MD, St. Brazos Emergency Department"
