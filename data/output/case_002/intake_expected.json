    "code": {
      "text": "CT Abdomen and Pelvis without contrast (renal stone protocol)"
    },
    "effectiveDateTime": "2026-10-09T03:12:00",
    "issued": "2026-10-09T04:01:00",
    "basedOn": [
      {
        "display": "Alicia Moreno, MD, St. Brazos Emergency Department"
      }
    ],
