    "code": {
      "text": "CT Chest without contrast"
    },
    "effectiveDateTime": "2026-10-14T14:05:00",
    "issued": "2026-10-14T16:52:00",
    "basedOn": [
      {
        "display": "Rebecca Lindqvist, PA-C, Riverside Urgent Care"
